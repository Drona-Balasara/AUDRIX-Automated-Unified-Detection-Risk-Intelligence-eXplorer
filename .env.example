# SAT-SA environment configuration (example).
#
# Copy the backend values below into `backend/.env` and the frontend value into
# `frontend/.env.local`, then adjust as needed. These are safe example values;
# never commit real credentials. Only `.env.example` files are tracked by Git.

# ---- Backend (read by the FastAPI app; prefix SATSA_) ----

# Deployment environment name (development | production | ...).
SATSA_ENVIRONMENT=development

# SQLAlchemy database URL. Defaults to a local SQLite file under ./data when
# unset. Example shown for clarity.
# SATSA_DATABASE_URL=sqlite:///./data/sat_sa.db

# Allowed CORS origins (comma-separated). Must include the Vite dev server.
SATSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application log level (DEBUG | INFO | WARNING | ERROR).
SATSA_LOG_LEVEL=INFO

# Maximum accepted upload size in bytes for the ingestion endpoints. Uploads
# larger than this are rejected with HTTP 413 before being buffered. Default 25 MiB.
SATSA_MAX_UPLOAD_BYTES=26214400

# Maximum number of individual validation errors echoed in an ingestion
# response. The report still reports the true total; only the detail list is
# capped to keep responses bounded.
SATSA_MAX_REPORTED_ERRORS=100

# ---- Frontend (read by Vite; prefix VITE_) ----
# Place this in frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8000/api/v1
